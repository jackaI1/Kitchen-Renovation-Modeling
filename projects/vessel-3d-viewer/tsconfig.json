{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "server",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "pipeline/*.ts"
  ]
}
